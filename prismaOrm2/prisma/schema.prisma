// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Alunos {
  id       Int    @id @default(autoincrement())
  nome     String
  email    String   @unique
  cod_usuario String 
  senha String
  idade    Int
  criadoEm DateTime @default(now())

  emprestimos Emprestimos[]
}

model Livros {
  id         Int      @id @default(autoincrement())
  titulo     String
  autor      String
  editora    String
  anoPublicacao Int
  criadoEm   DateTime @default(now())

   emprestimos Emprestimos[]
}

model Emprestimos {
  ID_Emprestimo Int        @id @default(autoincrement())
  ID_Livro      Int
  ID_Aluno      Int
    DT_Inicio   DateTime @default(now())
  DT_Fim        DateTime
  Observacao    String

  aluno Alunos @relation(fields: [ID_Aluno], references: [id])
  livro Livros @relation(fields: [ID_Livro], references: [id])

}